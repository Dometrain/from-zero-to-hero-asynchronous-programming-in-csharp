<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(NetVersion)</TargetFramework>
        <!-- The only difference from CompilerAsync.csproj: the runtime, not the C# compiler, builds the async state machines. -->
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Shared/**/*.cs" LinkBase="Shared" />
        <!-- Linked, not copied: chapter 02's Food.cs runs unchanged in both builds. -->
        <Compile Include="../../../../2. Async Await/2. Using Async/src/UsingAsync/Food.cs" Link="Chapter02/Food.cs" />
    </ItemGroup>

</Project>
