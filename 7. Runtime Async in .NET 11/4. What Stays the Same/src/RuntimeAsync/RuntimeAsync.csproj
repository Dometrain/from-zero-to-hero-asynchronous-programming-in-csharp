<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(NetVersion)</TargetFramework>
        <!-- The only difference from CompilerAsync.csproj: the runtime, not the C# compiler, builds the async state machines. -->
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Shared/**/*.cs" LinkBase="Shared" />
        <!-- Linked, not copied, so the demo proves chapter 04's file works unchanged in both builds. -->
        <Compile Include="../../../../4. Creating Task from Scratch/src/CreatingTaskFromScratch/DomeTrainTask.cs" Link="Chapter04/DomeTrainTask.cs" />
    </ItemGroup>

</Project>
