<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(NetVersion)</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <!-- Records what this project asked the compiler for, so the program can show a request that was silently ignored. -->
        <AssemblyMetadata Include="RequestedFeatures" Value="$(Features)" />
    </ItemGroup>

</Project>
